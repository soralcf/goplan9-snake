{
  "name": "go-asm-tools",
  "displayName": "Go Assembly Tools",
  "description": "Workspace-local Go Plan 9 assembly tooling: highlighting, completion, format-on-save, navigation, outline, and an offline handbook.",
  "version": "0.6.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:go.asm",
    "onCommand:goAsm.formatAll",
    "onCommand:goAsm.check",
    "onCommand:goAsm.openHandbook"
  ],
  "contributes": {
    "languages": [
      {
        "id": "go.asm",
        "aliases": [
          "Go Assembly",
          "Go Asm"
        ],
        "extensions": [
          ".s"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "go.asm",
        "scopeName": "source.go.asm",
        "path": "./syntaxes/go-asm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "goAsm.formatAll",
        "title": "Go Assembly: Format All .s Files"
      },
      {
        "command": "goAsm.check",
        "title": "Go Assembly: Check .s Formatting"
      },
      {
        "command": "goAsm.openHandbook",
        "title": "Go Assembly: Open Handbook"
      }
    ]
  }
}
